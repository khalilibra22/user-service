{
  "name": "user-service",
  "version": "1.0.0",
  "description": "E-learning Platform User Service with gRPC support",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/templates', 'dist/src/templates', {recursive: true})\"",
    "obfuscate": "javascript-obfuscator ./dist --output ./dist --compact true --self-defending false",
    "start": "node dist/index.js",
    "dev": "nodemon index.ts --exec ts-node index.ts",
    "prestart": "npm run build",
    "grpc:server": "ts-node src/grpc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/e-learning-platform-project1/user-service.git"
  },
  "keywords": [
    "grpc",
    "microservices",
    "e-learning",
    "user-service"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/e-learning-platform-project1/user-service/issues"
  },
  "homepage": "https://gitlab.com/e-learning-platform-project1/user-service#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.932.0",
    "@grpc/grpc-js": "^1.10.1",
    "@grpc/proto-loader": "^0.7.10",
    "@types/handlebars": "^4.0.40",
    "@types/nodemailer": "^7.0.11",
    "appwrite": "^17.0.1",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.1",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.13.3",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "sharp": "^0.34.5",
    "typeorm": "^0.3.21"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pino": "^7.0.4",
    "concurrently": "^9.2.1",
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}